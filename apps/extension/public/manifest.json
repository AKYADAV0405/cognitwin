{
  "manifest_version": 3,
  "name": "Cognitwin — Adaptive Cognitive Study Mode",
  "version": "0.1.0",
  "description": "Privacy-preserving passive study focus tracking and knowledge tracing companion.",
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Cognitwin Study Mode",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
