# ==============================================================================
# Cognitwin Environment Configuration Template (.env.example)
# Copy to .env and adjust values for your local environment.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cognitwin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/cognitwin
# SQLite Fallback: sqlite+aiosqlite:///./test.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognitwin

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security & JWT Tokens
# Generate secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Extension Auth Secret
EXTENSION_API_SECRET=dev-extension-secret-key-change-in-prod

# GNN-KT Inference Service
GNN_SERVICE_URL=http://localhost:8001
